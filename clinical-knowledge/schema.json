{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://preconsultas-dr-jimenez.local/schemas/clinical-knowledge-note-v1.json",
  "title": "Nota clinica aprobada para preconsulta",
  "description": "Contrato del frontmatter que puede entrar al manifiesto clinico. El cuerpo Markdown nunca se publica.",
  "type": "object",
  "required": [
    "id",
    "uso_preconsulta",
    "estado_clinico",
    "version",
    "fecha_revision",
    "area",
    "preguntas",
    "gatillos",
    "banderas",
    "fuentes"
  ],
  "properties": {
    "id": {
      "$ref": "#/definitions/slug"
    },
    "uso_preconsulta": {
      "const": true
    },
    "estado_clinico": {
      "const": "aprobado"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fecha_revision": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "area": {
      "$ref": "#/definitions/slug"
    },
    "preguntas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/pregunta"
      },
      "maxItems": 100
    },
    "gatillos": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/gatillo"
      },
      "maxItems": 200
    },
    "banderas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/bandera"
      },
      "maxItems": 100
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/fuente"
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "texto": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "valor": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "maxItems": 30,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "pregunta": {
      "type": "object",
      "required": [
        "id",
        "texto",
        "tipo"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "texto": {
          "$ref": "#/definitions/texto"
        },
        "tipo": {
          "enum": [
            "booleano",
            "seleccion-unica",
            "seleccion-multiple",
            "numero",
            "escala",
            "texto-corto"
          ]
        },
        "ayuda": {
          "$ref": "#/definitions/texto"
        },
        "requerida": {
          "type": "boolean"
        },
        "opciones": {
          "type": "array",
          "minItems": 2,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unidad": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "seleccion-unica",
                  "seleccion-multiple"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "opciones": {}
            },
            "required": [
              "opciones"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "numero",
                  "escala"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "min": {},
              "max": {}
            },
            "required": [
              "min",
              "max"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "gatillo": {
      "type": "object",
      "required": [
        "id",
        "pregunta_id",
        "operador",
        "valor",
        "efecto"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "pregunta_id": {
          "$ref": "#/definitions/slug"
        },
        "operador": {
          "enum": [
            "igual",
            "distinto",
            "incluye",
            "mayor-o-igual",
            "menor-o-igual"
          ]
        },
        "valor": {
          "$ref": "#/definitions/valor"
        },
        "efecto": {
          "type": "object",
          "required": [
            "tipo",
            "destino"
          ],
          "properties": {
            "tipo": {
              "enum": [
                "sugerir-instrumento",
                "mostrar-pregunta",
                "marcar-revision-medica"
              ]
            },
            "destino": {
              "$ref": "#/definitions/slug"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "bandera": {
      "type": "object",
      "required": [
        "id",
        "pregunta_id",
        "operador",
        "valor",
        "prioridad",
        "mensaje_medico"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/slug"
        },
        "pregunta_id": {
          "$ref": "#/definitions/slug"
        },
        "operador": {
          "enum": [
            "igual",
            "distinto",
            "incluye",
            "mayor-o-igual",
            "menor-o-igual"
          ]
        },
        "valor": {
          "$ref": "#/definitions/valor"
        },
        "prioridad": {
          "enum": [
            "alta",
            "media",
            "baja"
          ]
        },
        "mensaje_medico": {
          "$ref": "#/definitions/texto"
        }
      },
      "additionalProperties": false
    },
    "fuente": {
      "type": "object",
      "required": [
        "titulo"
      ],
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "anio": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 1000
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$",
          "maxLength": 300
        }
      },
      "anyOf": [
        {
          "properties": {
            "url": {}
          },
          "required": [
            "url"
          ]
        },
        {
          "properties": {
            "doi": {}
          },
          "required": [
            "doi"
          ]
        }
      ],
      "additionalProperties": false
    }
  }
}
