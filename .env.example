# Variables de entorno de la aplicación.
#
# Cópialo a ".env.local" para desarrollo, o configúralas en el panel del hosting
# (Vercel) para producción. NUNCA subas tus claves reales al repositorio.
#
# Sin estas variables, la app funciona en modo local de prueba (las respuestas se
# guardan solo en el navegador). Con ellas, se conecta a la base de datos del
# consultorio y las respuestas llegan desde cualquier dispositivo.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANONIMA_PUBLICA

# Buzón de estudios (opcional). Vacío = apagado. Para activarlo, corre
# supabase/schema-estudios.sql y pon aquí el nombre del bucket (por ejemplo "estudios").
VITE_ESTUDIOS_BUCKET=

# ── Bot de comentarios de Facebook (facebook-bot/README.md) ──────────────────
# Solo del lado del servidor (Vercel). Vacío o ausente = bot apagado.
# FB_BOT_MODO: apagado | simulacion | activo
FB_BOT_MODO=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
# Cadena que usted inventa; se escribe igual al dar de alta el webhook en Meta.
FB_VERIFY_TOKEN=
# Versión de la Graph API (por ejemplo la que muestre el panel de Meta). Vacío = la predeterminada de la app.
FB_GRAPH_VERSION=
ANTHROPIC_API_KEY=
# Opcionales
FB_BOT_MODELO=claude-opus-5-5
FB_BOT_TELEFONO=55 3048 5448
# 1 = además de la respuesta pública, un mensaje privado a quien preguntó.
FB_BOT_MENSAJE_PRIVADO=
# Avisos por correo (derivados y simulaciones); usa el RESEND_API_KEY de Resend.
RESEND_API_KEY=
FB_BOT_AVISO_CORREO=
FB_BOT_AVISO_ORIGEN=
